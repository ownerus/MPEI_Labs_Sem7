     <name>`Container`</name>
     <script>`const WRITING_FILE = 0;`#13#10`const READING_FILE = 1;`#13#10#13#10`const EDIT_TYPENUMBER = 10;`#13#10`const EDIT_CLASSNAME = "Edit";`#13#10`const TEXTLABEL_TYPENUMBER = 20;`#13#10`const TEXTLABEL_CLASSNAME = "TextLabel";`#13#10#13#10`const LEFTTOPPOINTX = 16;`#13#10`const LEFTTOPPOINTY = 16;`#13#10#13#10`const ALIGN_LEFT = 0;`#13#10`const ALIGN_CENTER = 1;`#13#10`const ALIGN_RIGHT = 2;`#13#10#13#10#13#10`function AllCellsPrimitivesExist:boolean;`#13#10#9`var i:integer, `#13#10#9#9#9`j:integer;`#13#10#9#13#10#9`AllCellsPrimitivesExist = LengthOfM(CellsPrimitivesId) `#62` 0;                   `#9#9#9#9#9`// Определене максимальной размерности матрицы CellsPrimitivesId, который содержит идентификаторы ячеек таблицы`#13#10#9#13#10#9`for(i = 1; Rows(CellsPrimitivesId))                                           `#9#9#9#9#9`// от 1 до количества строк матрицы CellsPrimitivesId`#13#10#9#9`for(j = 1; Cols(CellsPrimitivesId))                                         `#9#9#9#9#9`// от 1 до количества столбцов матрицы CellsPrimitivesId`#13#10#9#9#9#9`if (Length(GetObjName(CellsPrimitivesId[i,j])) `#60`= 0) `#13#10#9#9#9#9`or (GetOwnerContainer(CellsPrimitivesId[i,j]) `#60#62` GetCurrentContainer) then`#13#10#9#9#9#9#9`AllCellsPrimitivesExist = FALSE;                                                // Ошибка в текущих существующих ячейках`#13#10`end;`#13#10#13#10`// Функция очиски примитивов в контейнере`#13#10`procedure DeletePrimitivesByClassName(PrimitivClassName:string);`#13#10#9`var i:integer;`#13#10#9#13#10#9`for(i = GetObjCount, 1, -1)`#13#10#9`begin`#13#10#9#9`PrimitivId = GetObj(i);                                                     `#9#9#9#9#9`// Получение идетификаторов объектов`#13#10#9#9`if GetObjClassName(PrimitivId) = PrimitivClassName then RemovePrimitiv(PrimitivId);`#9#9`// Если текущий идентификатор равен классу примитивов, то удалить такой объект`#13#10#9`end;`#13#10`end;`#13#10#13#10`// Функция создания таблицы(ячеек с нулями)`#13#10`procedure CreateCellsPrimitives(RowsNumber:integer,ColsNumber:integer);`#13#10#9`var i:integer, `#13#10#9#9#9`j:integer;`#13#10#9#13#10#9`setsize(RowsNumber,ColsNumber,CellsPrimitivesId);                             `#9#9#9#9#9`// Установка количества строк и столбцов для матрицы идентификаторов ячеек CellsPrimitivesId`#13#10#9`for(i = 1; Rows(CellsPrimitivesId))`#13#10#9#9`for(j = 1; Cols(CellsPrimitivesId))`#13#10#9#9`begin`#13#10#9#9#9`CellsPrimitivesId[i,j] = CreatePrimitiv(EDIT_TYPENUMBER,[(0,0),(0,0),(0,0),(0,0)]);`#9`// Создать примитив Поле ввода с координатами`#13#10#9#9#9`SetPropAsString(CellsPrimitivesId[i,j], "Text", "0");                     `#9#9#9#9#9`// В ячейках установить нули`#13#10#9#9`end;`#13#10`end;`#13#10#13#10`// Функция установки свойств примитивов`#13#10`procedure RefreshCellsPrimitives;`#13#10#9`var i:integer,`#13#10#9#9#9`j:integer,`#13#10#9#9#9`RowsEdgesYPositions:array,`#13#10#9#9#9`ColsEdgesXPositions:array,`#13#10#9#9#9`LeftTopPoint:point,`#13#10#9#9#9`RightTopPoint:point,`#13#10#9#9#9`LeftBottomPoint:point,`#13#10#9#9#9`RightBottomPoint:point;`#13#10#9#13#10#9`setsize(RowsNumber+1,RowsEdgesYPositions);                                              // Установка размера строк матрицы RowsEdgesYPositions по количеству установленного в свойствах Количества строк + 1`#13#10#9`setsize(ColsNumber+1,ColsEdgesXPositions);                                              // Установка размера столбцов матрицы ColsEdgesXPositions по количеству установленного в свойствах Количества столбцов + 1`#13#10#9#13#10#9`RowsEdgesYPositions[1] = LEFTTOPPOINTY;                                                 // Для первой ячейки строки установить верхнюю левую позицию`#13#10#9`for(i = 2; Lengthofm(RowsEdgesYPositions))                                              // от второй до последней ячейки строки`#13#10#9#9`RowsEdgesYPositions[i] = RowsEdgesYPositions[i-1] + CellHeight;                       // новая позиция ячейки строки равна позиции предыдущей ячейки + размер ячейки по высоте`#13#10#9#9#13#10#9`ColsEdgesXPositions[1] = LEFTTOPPOINTX;                                                 // Для первой ячейки столбца установить верхнюю левую позицию`#13#10#9`for(i = 2; Lengthofm(ColsEdgesXPositions))                                              // от второй до последней ячейки столбца`#13#10#9#9`ColsEdgesXPositions[i] = ColsEdgesXPositions[i-1] + CellWidths[i-1];                  // новая позиция ячейки столбца равна позиции предыдущей ячейки + размер ячейки по ширине`#13#10#13#10#9`for(i = 1; Rows(CellsPrimitivesId))`#13#10#9#9`for(j = 1; Cols(CellsPrimitivesId))`#13#10#9#9`begin`#13#10#9#9#9`LeftTopPoint = (ColsEdgesXPositions[j],RowsEdgesYPositions[i]);                     // Координаты верхней левой позиции ячейки`#13#10#9#9#9`RightTopPoint = (ColsEdgesXPositions[j+1],RowsEdgesYPositions[i]);                  // Координаты верхней правой позиции ячейки`#13#10#9#9#9`LeftBottomPoint = (ColsEdgesXPositions[j],RowsEdgesYPositions[i+1]);                // Координаты нижней левой позиции ячейки`#13#10#9#9#9`RightBottomPoint = (ColsEdgesXPositions[j+1],RowsEdgesYPositions[i+1]);             // Координаты нижней правой позиции ячейки`#13#10#9#9#9`SetProp(CellsPrimitivesId[i,j], "Points", [LeftTopPoint,RightTopPoint,LeftBottomPoint,RightBottomPoint]);// Установка координат ячейки`#13#10#9#9#9`SetProp(CellsPrimitivesId[i,j], "Height", CellHeight);                              // Установка высоты ячейки`#13#10#9#9#9`SetProp(CellsPrimitivesId[i,j], "Width", CellWidths[j]);                            // Установка ширины ячейки`#13#10#9#9#9`SetFontSize(GetPropData(CellsPrimitivesId[i,j],"Font"), CellsFontSize);             // Установка стиля шрифта`#13#10#9#9#9`SetFontStyle(GetPropData(CellsPrimitivesId[i,j],"Font"), CellsFontStyle);`#13#10#9#9#9`SetFontColor(GetPropData(CellsPrimitivesId[i,j],"Font"), CellsFontColor);`#13#10#9#9#9#13#10#9#9#9`StorePosition(CellsPrimitivesId[i,j]); `#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9`// Сохранить координаты примитива, чтобы изменения положения и размеров не сбросились на следующем перерисовочном шаге`#13#10#9#9`end;`#13#10`end;`#13#10#13#10`// Функция проверки соответсвия текущей таблицы с её свойствами`#13#10`procedure InitCellsPrimitives;`#13#10#9`if (Rows(CellsPrimitivesId) `#60#62` RowsNumber)                                              // Если количество отрисованных строк не совпадает с установленным количеством строк`#13#10#9`or (Cols(CellsPrimitivesId) `#60#62` ColsNumber)                                              // Если количество отрисованных столбцов не совпадает с установленным количеством столбцов`#13#10#9`or (not AllCellsPrimitivesExist)                `#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9`// Если по каким-то причинам приимтив удален`#13#10#9`or (CellsFontChanged) then`#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9`// Если изменен шрифт ячеек (костыль, потому что в Edit шрифт не меняется, приходится удалять и создавать заново)`#13#10#9`begin`#13#10#9#9`CellsFontChanged = FALSE;                                                             // тогда флаг изменения шрифта "Нет"`#13#10#9#9`DeletePrimitivesByClassName(EDIT_CLASSNAME);                                          // удалить все ячейки`#13#10#9#9`setsize(0,0,CellsPrimitivesId); `#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9`// удалить идентификаторы ячеек из матрицы с идентификаторами ячеек`#13#10#9#9`CreateCellsPrimitives(RowsNumber,ColsNumber);`#13#10#9`end;`#13#10#9`RefreshCellsPrimitives;                                                                 // Установить новые свойства для примитивов(ячеек). Т.е. создать заново ячейки`#13#10`end;`#13#10#13#10`// Функция добавление наименований строк и столбцов`#13#10`procedure RefreshTableDecoration;`#13#10#9`var i:integer,`#13#10#9#9#9`Position:point,`#13#10#9#9#9`PrimitivId:integer,`#13#10#9#9#9`ColsEdgesXPositions:array;`#13#10#9#13#10#9`DeletePrimitivesByClassName(TEXTLABEL_CLASSNAME);                                       // Удалить все текстовые заголовки`#13#10#9#13#10#9`for(i = 1; RowsNumber)                                                                  // Создание наименований строк`#13#10#9`begin`#13#10#9#9`Position = (LEFTTOPPOINTX,LEFTTOPPOINTY + (i-1)*CellHeight);                    `#9#9#9`// Координаты для текста`#13#10#9#9`PrimitivId = CreatePrimitiv(TEXTLABEL_TYPENUMBER,[Position]);                         // Создание примитива Текст`#13#10#9#9`SetProp(PrimitivId, "Align", ALIGN_RIGHT);                                            // Положение вставки справа`#13#10#9#9`SetProp(PrimitivId, "Text", i);                                                       // Изменение текста на нумерацию`#13#10#9#9`SetFontSize(GetPropData(PrimitivId,"Font"), RowsNamesFontSize);                       // Установка шрифта`#13#10#9#9`SetFontStyle(GetPropData(PrimitivId,"Font"), RowsNamesFontStyle);`#13#10#9#9`SetFontColor(GetPropData(PrimitivId,"Font"), RowsNamesFontColor);`#13#10#9`end;`#13#10#9#13#10#9`setsize(ColsNumber+1,ColsEdgesXPositions);                                              // Массив в расположением ячеек по оси X `#13#10#9`ColsEdgesXPositions[1] = LEFTTOPPOINTX+(CellWidths[1]/2);                               // Позиция первого текста с наименованием столбца`#13#10#9`for(i = 2; Lengthofm(ColsEdgesXPositions))`#13#10#9#9`ColsEdgesXPositions[i] = ColsEdgesXPositions[i-1] + CellWidths[i-1];`#13#10#9#9#13#10#9`for(i = 1; ColsNumber)                                                                  // Создание наименований столбцов`#13#10#9`begin`#13#10#9#9`Position = (ColsEdgesXPositions[i],LEFTTOPPOINTY/2 - ((1/8)*ColsNamesFontSize));       `#9`// Координаты для текста`#13#10#9#9`PrimitivId = CreatePrimitiv(TEXTLABEL_TYPENUMBER,[Position]);                         // Создание примитива Текст`#13#10#9#9`SetProp(PrimitivId, "Align", ALIGN_CENTER);                                           // Положение вставки по центру`#13#10#9#9`SetProp(PrimitivId, "Alignment", ALIGN_LEFT);                                         // Стиль выравнивания слева`#13#10#9#9`SetProp(PrimitivId, "Text", GetItemStrict(ColsNames, i));                             // Изменение текста на наименвания столбцов`#13#10#9#9`SetFontSize(GetPropData(PrimitivId,"Font"), ColsNamesFontSize);                       // Установка шрифта`#13#10#9#9`SetFontStyle(GetPropData(PrimitivId,"Font"), ColsNamesFontStyle);`#13#10#9#9`SetFontColor(GetPropData(PrimitivId,"Font"), ColsNamesFontColor);`#13#10#9`end;`#13#10#13#10`end;`#13#10#13#10`// Функция получения значений записанных в таблицу (Для свойства "Запись в файл" для режима установки значенй "Через запись в ячейки")`#13#10`function GetCellsValues:matrix;`#13#10#9`var TableData:matrix,`#13#10#9#9#9`i:integer,`#13#10#9#9#9`j:integer,`#13#10#9#9#9`ErrorCode:integer;`#13#10#9`setsize(RowsNumber,ColsNumber,TableData);                                               // Установка для матрицы TableData количества строк и столбцов согласно установленным свойствам`#13#10#9`for(i = 1; Rows(CellsPrimitivesId))`#13#10#9#9`for(j = 1; Cols(CellsPrimitivesId))`#13#10#9#9#9`if (i `#60`= Rows(TableData)) and (j `#60`= Cols(TableData)) then                           // Для каждого элемента: если количество строк`#38`столбцов таблицы  совпадает или меньше количества строк`#38`столбцов таблицы`#13#10#9#9#9#9`TableData[i,j] = valf(GetProp(CellsPrimitivesId[i,j], "Text"), ErrorCode);        // тогда значение матрицы TableData равно значениям ячеек, преобразованных в строковые данные`#13#10#9`GetCellsValues = TableData;                                                             // Значение функции равно значению матрицы TableData `#13#10`end;`#13#10#13#10`// Функция записи значений из матрицы TableData в ячейки (Для свойства "Чтениие из файла") и (Для свойства "Запись в файл" для режима установки значенй "Через свойства")`#13#10`procedure SetCellsValues(TableData:matrix);`#13#10#9`var i:integer,`#13#10#9#9#9`j:integer;`#13#10#9`for(i = 1; Rows(CellsPrimitivesId))`#13#10#9#9`for(j = 1; Cols(CellsPrimitivesId))`#13#10#9#9#9`if (i `#60`= Rows(TableData)) and (j `#60`= Cols(TableData)) then                         `#9`// Для каждого элемента: если количество строк`#38`столбцов таблицы совпадает или меньше количества строк`#38`столбцов таблицы`#13#10#9#9#9#9`SetPropAsString(CellsPrimitivesId[i,j], "Text", TableData[i,j]);                `#9`// Установить для матрицы CellsPrimitivesId[i,j] значения из таблицы со значениями таблицы`#13#10`end;`#13#10#13#10`// Инициализация предназначения таблицы запись в файл/чтение из файла`#13#10`function GetInitTableValues:matrix;`#13#10#9`var TableData:matrix;`#13#10#9#13#10#9`if OperationMode = WRITING_FILE then                                                    // Таблица записывает свои значения в файл`#13#10#9`begin`#13#10#9#9`if ValueSettingMode = 0 then TableData = GetCellsValues;                        `#9#9#9`// Если значение в отображаемой таблице, тогда TableData равна значениям из ячеек`#13#10#9#9`if ValueSettingMode = 1 then                                                          // Если значение в свойствах  таблицы, тогда`#13#10#9#9`begin`#13#10#9#9#9`TableData = SettingTableValues;                                             `#9#9#9#9`// TableData равна таблице в свойстве`#13#10#9#9#9`ColsNumber = Cols(TableData);                                                       // Число столбцов равна числу столбцов в TableData`#13#10#9#9#9`RowsNumber = Rows(TableData);                                                       // Число строк равна числу строк в TableData`#13#10#9#9`end;`#13#10#9`end;`#13#10#9`if OperationMode = READING_FILE then                                                    // Таблица считывает значения из файла`#13#10#9`begin`#13#10#9#9`TableData = Transp(LoadTab(Filename));                                                // TableData равна транспонированной таблице в файле`#13#10#9#9`ColsNumber = Cols(TableData);                                                         // Число столбцов равна числу столбцов в TableData`#13#10#9#9`RowsNumber = Rows(TableData);                                                         // Число строк равна числу строк в TableData`#13#10#9`end;`#13#10#13#10#9`GetInitTableValues = TableData;                                                         // Функция равна записанной или считанной таблице TableData`#13#10`end;`#13#10#13#10#9#13#10`Initialization`#13#10#9`var TableData:matrix;`#13#10#9`TableData = GetInitTableValues;                                                       `#9`// Выполнение функции предназначения таблицы`#13#10#9`InitCellsPrimitives;`#9`                                                                `#9`// Проверка правильности отображения таблицы и её свойств`#13#10#9`SetCellsValues(TableData);                                                            `#9`// Запись значений из матрицы TableData в ячейки`#13#10#9`RefreshTableDecoration;                                                               `#9`// Создать подписи к столбцам и строкам`#13#10`end;`#13#10#13#10#9`TableData = GetInitTableValues;                                                       `#9`// Выполнение функции предназначения таблицы`#13#10`//`#9`InitCellsPrimitives;`#9`                                                                `#9`// Проверка правильности отображения таблицы и её свойств`#13#10#9`SetCellsValues(TableData);                                                            `#9`// Запись значений из матрицы TableData в ячейки`#13#10`//`#9`RefreshTableDecoration;                                                               `#9`// Создать подписи к столбцам и строкам`#13#10#13#10#13#10`if OperationMode = WRITING_FILE then                                                      // Если предназначение таблицы - запись данных в файл`#13#10`begin`#13#10#9`if ValueSettingMode = 0 then SaveTab(Transp(GetCellsValues), FileName);                 // тогда записать транспонированную матрицу в файл`#13#10#9`if ValueSettingMode = 1 then SaveTab(Transp(SettingTableValues), FileName);               `#9#9`// тогда записать транспонированную матрицу в файл`#13#10`end;`#13#10#13#10`if OperationMode = READING_FILE then                                                      // Если предназначение таблицы - чтение данных из файла`#13#10#9`SetCellsValues(Transp(LoadTab(Filename)));                                              // тогда записать транспонированные значения матрицы из файла в таблицу`#13#10#9#13#10#9`//Запись значений из таблицы в параметр`#13#10#9`DisplayedTableValues = GetCellsValues;`</script>
