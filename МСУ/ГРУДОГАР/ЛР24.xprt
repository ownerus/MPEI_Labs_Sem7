in`#13#10#9#9` //если отрицательное число то + нет`#13#10#9#9` if (buffer2`#60`=0) then str = str + " " else str = str + " +";`#13#10#9#9` end else `#13#10#9#9#9`//последние s  без пробела для показателя степени`#13#10#9`    if (buffer2`#62`0) then str = str + "+"; //(i=2)`#13#10#9` end`#9`//(buffer1`#60#62`0) `#13#10#9`  else // проверяем что идет за 0`#13#10#9#9#9` if (buffer2`#62`0) then str = str + "+"; //добавляем плюс если следующее `#62`0`#13#10#9`end; //for`#13#10#9`if (n=1) then str = FloatToStr(b[1,1]) else`#13#10`   if (buffer2`#60#62`0) then str = str + FloatToStr(buffer2);`#13#10` Text.Text = str;`#13#10#13#10` //Вычисляем ширину текста числителя`#13#10` TxtSize = gettextsize(Text.Text,Text.Font);`#13#10` If (real(TxtSize)`#62`Width) then Text.Text = NStrdefault //Строка по умолчанию`#13#10`  else `#13#10#9` begin`#13#10`   TextPosX = -real(TxtSize)/2; //начало текста при позиционирование по центру`#13#10`   //формируем показатели степени`#13#10#9` for (i=1, n-2)`#13#10#9#9`if (b[1,n-i+1]`#60#62`0) then`#13#10`     begin`#13#10#9`   pr_id = createprimitiv(29,[(TextPosX+shiftvector[i], -16)]);`#13#10#9`   newname = "Textsn_2"+floattostr(i);                            `#13#10`     setpropasstring(pr_id,"Name",newname);`#13#10#9`   setpropasstring(pr_id,"Text",floattostr(n-i)); `#13#10`     setfontprop(pr_id, "size", FontSize);`#13#10#9`   end;`#13#10#9` end;//строка уменьшается в блок`#13#10`end;`</script>
